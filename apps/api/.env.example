PORT=3001
NODE_ENV=development

# In production, Clerk is mandatory unless AUTH_REQUIRED=false (demo only).
AUTH_REQUIRED=

# Public-facing base URL used to build absolute URIs (audio uploads, output
# files). Required in production. In dev, derived from the Host header.
PUBLIC_API_URL=

# Comma-separated allowlist of origins permitted via CORS, or "*" for any.
# Leave blank in dev (defaults to "any"); in production an empty value
# disables cross-origin requests entirely.
CORS_ORIGIN=

DATABASE_URL=
REDIS_URL=
CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Mapbox (geocoding + satellite static images). Leave blank in dev to use
# deterministic Melbourne-suburb fallback.
MAPBOX_TOKEN=

# Vicmap open data (free, CC BY 4.0). Set to "true" to fetch real lot polygons
# from opendata.maps.vic.gov.au instead of the mock 15x40m rectangle. Only
# works for Victorian addresses; falls back silently for anything outside.
VICMAP_ENABLED=

# OpenAI (Whisper transcription). Leave blank in dev for canned transcript.
OPENAI_API_KEY=

# Anthropic Claude (design generation, audit). Leave blank in dev for a
# deterministic two-zone mock design.
ANTHROPIC_API_KEY=

# MYOB AccountRight / MYOB Business. Leave blank in dev for canned customers
# and items. Live mode requires all four:
MYOB_CLIENT_ID=
MYOB_CLIENT_SECRET=
MYOB_ACCESS_TOKEN=
MYOB_COMPANY_FILE_ID=
MYOB_CFTOKEN=
# UID of the GL account invoice lines should hit (Sales / Income).
MYOB_INCOME_ACCOUNT_UID=

# Twilio for WhatsApp + SMS task notifications and materials checklists.
# Without these, notify.ts logs the message instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Weather. Open-Meteo needs no key; set WEATHER_DISABLED=true to force
# the deterministic dev forecast.
WEATHER_DISABLED=

# Trade suppliers (Bunnings, Boral, Holcim, Andersons, ANL, Online Plants,
# Speciality Trees). Set SUPPLIERS_LIVE=true once real scraper adapters
# land; until then every supplier returns canned pricing.
SUPPLIERS_LIVE=

# Xero parallel to MYOB. Live mode requires:
XERO_ACCESS_TOKEN=
XERO_TENANT_ID=
XERO_INCOME_ACCOUNT_CODE=200

# Stripe deposit collection on accepted quotes. Live mode requires:
STRIPE_SECRET_KEY=
# Webhook signing secret from the Stripe dashboard's endpoint config.
# In dev (NODE_ENV != production) signature verification is skipped so
# Stripe CLI forwarding works without round-tripping the secret.
STRIPE_WEBHOOK_SECRET=
# Deposit % of the Standard scenario total.
DEPOSIT_PCT=20

# Client portal — HMAC secret for the stateless magic-link tokens
# (signPortalToken / verifyPortalToken in lib/magic-link.ts). Generate a
# 32+ byte random string per deploy; rotate when revoking outstanding
# links. Required in production.
WORKSTREAM_PORTAL_SECRET=
# Legacy alias (still read): CONSTRUCT_PORTAL_SECRET=
# Public base URL where the client-facing portal web app lives.
PORTAL_BASE_URL=
