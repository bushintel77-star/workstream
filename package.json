{
  "name": "workstream",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint apps/api/src packages/domain/src packages/contracts/src --max-warnings 50",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @workstream/web test:e2e",
    "test:watch": "vitest",
    "mobile:check-placeholders": "grep -r 'REPLACE_AFTER_eas_init' apps/mobile/app.json && exit 1 || exit 0",
    "web:check-portal-edge": "! grep -r \"import.*'fs'\" apps/web/src/app/portal/",
    "ci": "pnpm install --frozen-lockfile && pnpm typecheck && pnpm test",
    "mobile:check-placeholders": "grep -r 'REPLACE_AFTER_eas_init' apps/mobile/app.json && exit 1 || exit 0",
    "build:docker:api": "docker build -f apps/api/Dockerfile -t construct-api:local .",
    "build:docker:web": "docker build -f apps/web/Dockerfile --build-arg NEXT_PUBLIC_API_URL=https://construct-api.fly.dev -t construct-web:local .",
    "build:docker": "pnpm build:docker:api && pnpm build:docker:web",
    "deploy:fly": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -File scripts/deploy-fly.ps1':'bash scripts/deploy-fly.sh',{stdio:'inherit'})\"",
    "clean": "turbo clean",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^2.1.9"
  }
}
