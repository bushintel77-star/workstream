{
  "name": "workstream",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint apps/api/src packages/domain/src packages/contracts/src --max-warnings 50",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @workstream/web test:e2e",
    "test:watch": "vitest",
    "mobile:check-placeholders": "node scripts/check-mobile-placeholders.mjs",
    "web:check-portal-edge": "node scripts/check-portal-edge.mjs",
    "web:check-handoff-colors": "node scripts/check-handoff-chrome-colors.mjs",
    "ci": "pnpm install --frozen-lockfile && pnpm mobile:check-placeholders && pnpm web:check-portal-edge && pnpm web:check-handoff-colors && pnpm typecheck && pnpm lint && pnpm test",
    "build:docker:api": "docker build -f apps/api/Dockerfile -t construct-api:local .",
    "build:docker:web": "docker build -f apps/web/Dockerfile --build-arg NEXT_PUBLIC_API_URL=https://construct-api.fly.dev -t construct-web:local .",
    "build:docker": "pnpm build:docker:api && pnpm build:docker:web",
    "deploy:fly": "node -e \"require('child_process').execSync(process.platform==='win32'?'powershell -File scripts/deploy-fly.ps1':'bash scripts/deploy-fly.sh',{stdio:'inherit'})\"",
    "clean": "turbo clean",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@next/eslint-plugin-next": "^16.2.12",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
