{
  "name": "construct",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo clean",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "tsc --noEmit -p tsconfig.base.json --pretty false || true"
    ]
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.6"
  }
}
