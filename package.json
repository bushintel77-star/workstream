{
  "name": "workstream",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint apps/api/src apps/web/src packages/domain/src packages/contracts/src --max-warnings 0",
    "typecheck": "turbo typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @workstream/web test:e2e",
    "test:watch": "vitest",
    "mobile:check-placeholders": "node scripts/check-mobile-placeholders.mjs",
    "mobile:check-distribution": "node scripts/check-mobile-distribution.mjs",
    "web:check-portal-edge": "node scripts/check-portal-edge.mjs",
    "web:check-handoff-colors": "node scripts/check-handoff-chrome-colors.mjs",
    "web:check-studio-dialect": "node scripts/check-studio-dialect.mjs",
    "web:check-tier1-2026-spec": "node scripts/check-tier1-2026-spec-gap.mjs",
    "web:check-reachability": "node scripts/check-feature-reachability.mjs",
    "web:check-css-scales": "node scripts/check-css-scales.mjs",
    "web:check-bundle-size": "pnpm exec turbo run build --filter=@workstream/web... && node scripts/check-bundle-size.mjs",
    "ci": "pnpm install --frozen-lockfile && pnpm mobile:check-placeholders && pnpm mobile:check-distribution && pnpm web:check-portal-edge && pnpm web:check-handoff-colors && pnpm web:check-studio-dialect && node scripts/check-tier1-2026-spec-gap.mjs --require && pnpm web:check-reachability && pnpm web:check-css-scales && pnpm web:check-bundle-size && pnpm typecheck && pnpm lint && pnpm test",
    "build:docker:api": "docker build -f apps/api/Dockerfile -t workstream-api:local .",
    "build:docker:web": "docker build -f apps/web/Dockerfile --build-arg NEXT_PUBLIC_API_URL=https://api-production-a8ff1.up.railway.app -t workstream-web:local .",
    "build:docker": "pnpm build:docker:api && pnpm build:docker:web",
    "clean": "turbo clean",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
